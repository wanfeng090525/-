<?xml version="1.0" encoding="utf-8"?>
<!--
  ~  bottom_navigation_float_dark.xml
  ~  iOS "glass" floating tab bar background (dark) — rounded pill with a subtle
  ~  translucent fill + thin top light hairline, matching the Mobile App UI design.
  -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EF121418" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="21dp" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>